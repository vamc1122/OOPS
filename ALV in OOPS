              lv_srno = lv_srno + 1.
              wa_output-srno = lv_srno.
              CONCATENATE wa_output-msg_err w_msg1  INTO wa_output-msg_err  SEPARATED BY space.
              CLEAR: w_msg1.
              APPEND wa_output TO it_output.
            ENDLOOP.
            IF it_output IS NOT INITIAL.
              c1=>display_error( ).
            ENDIF.
          ENDIF.
