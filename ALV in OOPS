            PERFORM bdc_field       USING lv_field3
                                          lv_deldate. "" DELIVERY DATE
            CONCATENATE 'EKPO-WERKS' '(' ls_num ')' INTO lv_field4.
            PERFORM bdc_field       USING lv_field4
                                          wa_update_data1-werks.
            CONCATENATE 'EKPO-LGORT' '(' ls_num ')' INTO lv_field5.

            READ TABLE lt_mard INTO DATA(wa_mard) WITH KEY werks = wa_update_data1-werks
                                                           matnr = wa_update_data1-matnr.

            PERFORM bdc_field       USING lv_field5
                                          wa_mard-lgort.


            CLEAR: wa_update_data1.
          ENDLOOP.
          " com
          PERFORM bdc_dynpro      USING 'SAPMM06E' '0320'.
          PERFORM bdc_field       USING 'BDC_CURSOR'
                                        'EKKO-ANGDT'.
          PERFORM bdc_field       USING 'BDC_OKCODE'
