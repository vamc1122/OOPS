  METHOD download_template.

    CONCATENATE '/usr/sap/' sy-sysid '/D00/data/upload/template'
    INTO ls_file.

    CONCATENATE ls_file '/ymm_ipa_new' INTO ls_file.

*// Open dataset, From application server get the data
    OPEN DATASET ls_file
*      FOR INPUT IN TEXT MODE ENCODING DEFAULT. "NON-UNICODE.      "Comment by Jahnavi()
      FOR INPUT IN TEXT MODE ENCODING NON-UNICODE.

    IF sy-subrc <> 0.
      MESSAGE TEXT-092 TYPE 'I'.
      LEAVE LIST-PROCESSING.

    ELSE.
*// Read the data from app server and put into variable
      DO.
        READ DATASET ls_file INTO lv_data.
*// Append workarea to internal table
        IF sy-subrc = 0.
          IF lv_data CN '#'.
            lv_len = strlen( lv_data ).
            lv_len = lv_len - 1.
            lv_data = lv_data+0(lv_len).
          ENDIF.
          ls_final-var1 = lv_data.
          APPEND ls_final TO lt_final.
          CLEAR ls_final.
        ELSE.
          EXIT.
        ENDIF.
      ENDDO.
    ENDIF.

*// Split file name and put in to internal table
    SPLIT ls_file AT '/' INTO TABLE lt_final1.

*// Count how many records in internal table
    DATA(lv_count) = lines( lt_final1 ).

    READ TABLE lt_final1 INTO DATA(ls_final1) INDEX lv_count.

*// close the path
    CLOSE DATASET ls_file.

    CALL METHOD cl_gui_frontend_services=>file_save_dialog
      EXPORTING
        window_title      = 'File Directory'
        default_extension = 'csv'
        initial_directory = 'D:\'
      CHANGING
        filename          = lv_filename
        path              = lv_path1
        fullpath          = lv_fullpath
        user_action       = lv_result.

    lv_path = lv_fullpath.

*// Fm for download the file into presenation server
    CALL FUNCTION 'GUI_DOWNLOAD'
      EXPORTING
        filename                  = lv_path
        filetype                  = 'ASC'
        write_field_separator     = 'X'
        trunc_trailing_blanks     = 'X'
        trunc_trailing_blanks_eol = 'X'
        write_lf_after_last_line  = ' '
      TABLES
        data_tab                  = lt_final
      EXCEPTIONS
        file_write_error          = 1
        no_batch                  = 2
        gui_refuse_filetransfer   = 3
        invalid_type              = 4
        no_authority              = 5
        unknown_error             = 6
        header_not_allowed        = 7
        separator_not_allowed     = 8
        filesize_not_allowed      = 9
        header_too_long           = 10
        dp_error_create           = 11
        dp_error_send             = 12
        dp_error_write            = 13
        unknown_dp_error          = 14
        access_denied             = 15
        dp_out_of_memory          = 16
        disk_full                 = 17
        dp_timeout                = 18
        file_not_found            = 19
        dataprovider_exception    = 20
        control_flush_error       = 21
        OTHERS                    = 22.

    IF sy-subrc EQ 0.
      MESSAGE: TEXT-093 TYPE 'I'.
    ELSE.
      MESSAGE: TEXT-094 TYPE 'I'.
    ENDIF.

    REFRESH : lt_final.                         "Added by Jahnavi

  ENDMETHOD.
