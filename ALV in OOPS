          CLEAR: ls_num.

          lv_item = 10.
          CONDENSE lv_item.
          LOOP AT it_update_data INTO DATA(wa_update_data1) WHERE chk = 'X'.
            ls_num = ls_num + 1.
            wa_update_data1-del_date = lv_deldate.
            IF ls_num > 15.
              lv_item = lv_item + 10.
              CONDENSE lv_item.
              PERFORM bdc_dynpro      USING 'SAPMM06E' '0320'.
              PERFORM bdc_field       USING 'RM06E-EBELP' lv_item.
              PERFORM bdc_field       USING 'BDC_OKCODE'
                                          '/00'.
            ENDIF.

            CONDENSE ls_num.
            PERFORM bdc_dynpro      USING 'SAPMM06E' '0320'.
            PERFORM bdc_field       USING 'BDC_CURSOR'
