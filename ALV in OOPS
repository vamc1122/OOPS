" Eoc  SHDK925010
                MODIFY zinfo FROM wa_info.
                IF sy-subrc = 0.
                  COMMIT WORK AND WAIT.
                ENDIF.
                CLEAR :wa_info.
              ENDLOOP.
              MESSAGE TEXT-028 TYPE 'S'.
              LOOP AT it_update_data INTO wa_update_data WHERE chk = 'X'.
                wa_update_data-rfq_no = w_msg-msgv2.
                MODIFY it_update_data FROM wa_update_data TRANSPORTING rfq_no WHERE chk = 'X'.
              ENDLOOP.
