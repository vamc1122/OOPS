          FOR ALL ENTRIES IN @it_update_data
          WHERE werks = @it_update_data-werks.

        SELECT lgort,matnr,werks FROM mard
          INTO TABLE @DATA(lt_mard)
          FOR ALL ENTRIES IN @it_update_data
          WHERE werks = @it_update_data-werks
          AND   matnr = @it_update_data-matnr.

