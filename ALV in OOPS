            MESSAGE lv_msg TYPE 'I'.
            EXIT.
          ENDIF.
        ENDIF.
        READ TABLE it_marc INTO DATA(wa_marc) WITH KEY matnr = wa_update_data-matnr werks = wa_update_data-werks.
        IF sy-subrc = 0.
         wa_update_data-ekgrp = wa_marc-ekgrp.
        ENDIF.

        MODIFY it_update_data FROM wa_update_data TRANSPORTING ekgrp
        WHERE matnr = wa_update_data-matnr AND werks = wa_update_data-werks.

        CLEAR: wa_update_data, lv_datum, lv_datab,
               lv_datbi.
      ENDLOOP.


