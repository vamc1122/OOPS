FORM bdc_dynpro USING program dynpro ##PERF_NO_TYPE.
  CLEAR t_bdcdata.
  t_bdcdata-program  = program.
  t_bdcdata-dynpro   = dynpro.
  t_bdcdata-dynbegin = 'X'.
  APPEND t_bdcdata .
ENDFORM.

*----------------------------------------------------------------------*
*        Insert field                                                  *
*----------------------------------------------------------------------*
FORM bdc_field USING fnam fval ##PERF_NO_TYPE.
  IF fval <> nodata.
    CLEAR t_bdcdata.
    t_bdcdata-fnam = fnam.
    t_bdcdata-fval = fval.
    APPEND t_bdcdata.
  ENDIF.
ENDFORM.
