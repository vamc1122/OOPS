              CONDENSE: ls_num.
              PERFORM bdc_field       USING 'RM06E-EBELP' lv_item.
            ELSE.
              PERFORM bdc_field       USING 'RM06E-EBELP' '10'.
            ENDIF.

            CONCATENATE  'EKPO-EMATN' '(' ls_num ')' INTO lv_field1.
            PERFORM bdc_field       USING lv_field1
                                          wa_update_data1-matnr.
            CONCATENATE 'RM06E-ANMNG' '(' ls_num ')' INTO lv_field2.
