                                        'ZAN'.
          PERFORM bdc_field       USING 'EKKO-SPRAS'
                                        'EN'.
          PERFORM bdc_field       USING 'RM06E-ANFDT'
                                        lv_cdate.
          PERFORM bdc_field       USING 'EKKO-ANGDT'
