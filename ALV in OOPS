                wa_info-mcp                = wa_update_data-mcp.
                wa_info-ppc                = wa_update_data-ppc.
                wa_info-zinput_rm           = wa_update_data-input_rm.
                wa_info-zprocess_cost       = wa_update_data-process_cost.
                wa_info-zbop_cost           = wa_update_data-bop_cost.
