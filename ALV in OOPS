          PERFORM bdc_field       USING 'EKKO-ANGDT'
                                       lv_cdate1.
          PERFORM bdc_field       USING 'RM06E-EBELP'
                                        '10'.           "" SEE
          PERFORM bdc_dynpro      USING 'SAPMM06E' '0140'.
          PERFORM bdc_field       USING 'BDC_CURSOR'
