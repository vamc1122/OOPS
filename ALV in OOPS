  METHOD process_logic.

    upload_data( ).

    DATA :
      lv_datum TYPE sy-datum,
      lv_datab TYPE sy-datum,
      lv_datbi TYPE sy-datum..

    IF it_update_data IS NOT INITIAL.

      SELECT zrfq_ebeln
             zrfq_ebelp
             zlifnr
             zsa_matnr
             ekorg
             zsa_werks
             esokz
             zinfo_type
         FROM zinfo INTO TABLE it_info FOR ALL ENTRIES IN it_update_data
       WHERE zlifnr     = it_update_data-lifnr
         AND zsa_matnr  = it_update_data-matnr
         AND ekorg      = it_update_data-ekorg
         AND zsa_werks  = it_update_data-werks
         AND esokz      = it_update_data-esokz
         AND zinfo_type = 'YMM_IPA_NEW'.

    SELECT lifnr,
           matnr,
           werks,
           esokz,
           ekorg
    FROM a017 INTO TABLE @DATA(it_a017)
            FOR ALL ENTRIES IN @it_update_data
    WHERE matnr = @it_update_data-matnr
    AND   werks = @it_update_data-werks
    AND   lifnr = @it_update_data-lifnr.

      SELECT lifnr,ekorg,waers FROM lfm1
            INTO TABLE @DATA(it_lfm1)
            FOR ALL ENTRIES IN @it_update_data
            WHERE lifnr = @it_update_data-lifnr
            AND ekorg = @it_update_data-ekorg.

      SELECT matnr,werks,ekgrp FROM marc
        INTO TABLE @DATA(it_marc)
        FOR ALL ENTRIES IN @it_update_data
        WHERE matnr = @it_update_data-matnr
         AND werks  = @it_update_data-werks.

      SELECT matnr FROM mara INTO TABLE @DATA(it_mara)
        FOR ALL ENTRIES IN @it_update_data
        WHERE matnr = @it_update_data-matnr.

      SELECT werks, ekorg FROM t001w INTO TABLE @DATA(it_t001w)
         FOR ALL ENTRIES IN @it_update_data WHERE werks = @it_update_data-werks
        AND ekorg = @it_update_data-ekorg.

      SELECT mwskz FROM eine INTO TABLE @DATA(it_eine)
        FOR ALL ENTRIES IN @it_update_data
        WHERE mwskz = @it_update_data-mwskz.

      SELECT tabname, fieldname,as4local,datatype,leng,decimals,domname FROM dd03l
        INTO TABLE @DATA(it_dd03l)
        WHERE tabname = 'ZPIR_WARRANTY'
        AND as4local = 'A'
        AND fieldname IN @lr_fields.

      LOOP AT it_update_data INTO wa_update_data.

        IF wa_update_data-lifnr IS INITIAL.
          lv_msg = TEXT-033.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-ekorg IS INITIAL .
          lv_msg = TEXT-034.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-matnr IS INITIAL .
          lv_msg = TEXT-035.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-prev_part IS INITIAL .
          lv_msg = TEXT-036.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-ekorg IS INITIAL .
          lv_msg = TEXT-038.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-werks IS INITIAL .
          lv_msg = TEXT-039.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-esokz IS INITIAL .
          lv_msg = TEXT-040.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-aplfz IS INITIAL .
          lv_msg = TEXT-041.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-norbm IS INITIAL .
          lv_msg = TEXT-042.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-mwskz IS INITIAL .
          lv_msg = TEXT-043.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
*        ELSEIF wa_update_data-netpr IS INITIAL .
*          lv_msg = TEXT-044.
*          MESSAGE lv_msg TYPE 'I'.
*          EXIT.
        ELSEIF wa_update_data-datab IS INITIAL .
          lv_msg = TEXT-045.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-datbi IS INITIAL .
          lv_msg = TEXT-046.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ELSEIF wa_update_data-jira_id IS INITIAL .
          lv_msg = TEXT-047.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
** SOC by Aplus05(Jahnavi)   SHDK925010 <<<<<<
        ELSEIF wa_update_data-datab IS NOT INITIAL.
          CALL FUNCTION 'CONVERT_DATE_TO_INTERNAL'
            EXPORTING
              date_external            = wa_update_data-datab
            IMPORTING
              date_internal            = lv_datum
            EXCEPTIONS
              date_external_is_invalid = 1
              OTHERS                   = 2.
          IF sy-subrc <> 0.
* Implement suitable error handling here
          ENDIF.
          IF lv_datum NE sy-datum.
            lv_msg = TEXT-110.
            MESSAGE lv_msg TYPE 'I'.
            EXIT.
          ENDIF.
        ENDIF.
        CALL FUNCTION 'CONVERT_DATE_TO_INTERNAL'
          EXPORTING
            date_external            = wa_update_data-datbi
          IMPORTING
            date_internal            = lv_datbi
          EXCEPTIONS
            date_external_is_invalid = 1
            OTHERS                   = 2.
        IF sy-subrc <> 0.
* Implement suitable error handling here
        ENDIF.
        lv_datab = lv_datum.
        IF lv_datab > lv_datbi .
          lv_msg = TEXT-109.
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
        ENDIF.
** EOC by Aplus05(Jahnavi)  SHDK925010 >>>>>>

        IF r1 = abap_true.
          IF wa_update_data-warr_grn IS INITIAL.
            lv_msg = TEXT-048.
            MESSAGE lv_msg TYPE 'I'.
            EXIT.
          ELSEIF wa_update_data-warr_per IS INITIAL .
            lv_msg = TEXT-049.
            MESSAGE lv_msg TYPE 'I'.
            EXIT.
          ELSEIF wa_update_data-factor IS INITIAL .
            lv_msg = TEXT-050.
            MESSAGE lv_msg TYPE 'I'.
            EXIT.
          ENDIF.
        ENDIF.

*        IF wa_update_data-netpr IS NOT INITIAL AND wa_update_data-netpr LT 0.
*          lv_msg = | In Vendor { wa_update_data-lifnr } Net Price is in Negative { wa_update_data-netpr } in Upload File. Kindly Check | ##NO_TEXT.
*          MESSAGE lv_msg TYPE 'I'.
*          EXIT.
*        ENDIF.

        READ TABLE it_a017 INTO DATA(wa_a017) WITH KEY matnr = wa_update_data-matnr
                                                       lifnr = wa_update_data-lifnr
                                                       esokz = wa_update_data-esokz
                                                       werks = wa_update_data-werks
                                                       ekorg = wa_update_data-ekorg.
        IF sy-subrc = 0.
          lv_msg = | Given { wa_update_data-matnr } & { wa_update_data-lifnr } Combination Info Record Already Available | .
          MESSAGE lv_msg TYPE 'I'.
          EXIT.
