            IF sy-subrc = 0.
              LOOP AT it_update_data INTO wa_update_data WHERE chk = 'X' ##INTO_OK.
                wa_info-zsa_matnr          = wa_update_data-matnr.
                wa_info-zsa_werks          = wa_update_data-werks.
