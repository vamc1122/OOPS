CLASS lcl_class IMPLEMENTATION.

  METHOD fetch_logic.

    SELECT a~material AS matnr ,
           a~plant AS werks,
           a~quotaarrangement AS qunum,
           b~maktx
  FROM i_purgquotaarrgmt AS a "i_purgquotaarrgmt(equk cds view)
  INNER JOIN makt AS b ON b~matnr EQ a~material
   WHERE a~material IN @s_partno
      AND a~plant IN @s_werks
      INTO CORRESPONDING FIELDS OF TABLE @gt_equk. "#EC CI_NO_TRANSFORM.

    IF gt_equk IS NOT INITIAL.

      SELECT b~quotaarrangement AS qunum,
         b~supplier AS lifnr,
         b~quotaarrangementitem AS qupos,
         b~purchasingsourcequota AS quote,
         c~adrnr,
         d~name1
     FROM i_purgquotaarrgmtitem AS b " i_purgquotaarrgmtitem(equp cds view)
     INNER JOIN lfa1 AS c ON c~lifnr EQ b~supplier
     INNER JOIN ekko AS e ON e~lifnr EQ c~lifnr AND e~bsart = @p_bsart
     INNER JOIN adrc AS d ON d~addrnumber EQ c~adrnr
     FOR ALL ENTRIES IN @gt_equk
     WHERE ( b~supplier IN @s_lifnr1 OR b~supplier IN @s_lifnr2 )
     AND b~quotaarrangement EQ @gt_equk-qunum
     AND e~bsart = @p_bsart
     AND e~bukrs = '2000'
     INTO CORRESPONDING FIELDS OF TABLE @gt_lifnr_det1. "#EC CI_NO_TRANSFORM

    ENDIF.

    IF sy-subrc EQ 0.

      SELECT a~matnr,
             a~werks,
             a~lifnr,
             a~knumh,
             b~kbetr
      FROM a017 AS a                                    "#EC CI_NOORDER
      INNER JOIN konp AS b ON b~knumh EQ a~knumh       "#EC CI_BUFFJOIN
      WHERE a~matnr IN @s_partno
      AND a~werks IN @s_werks
      AND ( a~lifnr IN @s_lifnr1 OR a~lifnr IN @s_lifnr2 )
      AND a~ekorg EQ '2000'
      AND a~datbi GE @sy-datum
      AND a~datab LE @sy-datum
      INTO TABLE @gt_unit_price_det.               "#EC CI_NO_TRANSFORM


      it_budat = VALUE #(
      ( sign = 'I' option = 'BT' low = ( sy-datum - 90 ) high = sy-datum ) ).

      SELECT a~matnr,
             a~lifnr,
             a~werks,
             a~bwart,
             a~menge
      FROM matdoc AS a
      WHERE a~matnr IN @s_partno
      AND a~werks IN @s_werks
      AND ( a~lifnr IN @s_lifnr1 OR a~lifnr IN @s_lifnr2 )
      AND a~bwart IN ( '101', '102' )
      AND a~budat IN @it_budat
      INTO TABLE @gt_matdoc.                           "#EC CI_NOFIELD.

    ELSE.
      MESSAGE TEXT-002 TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.

  ENDMETHOD.

  METHOD process_logic.

    fetch_logic( ).

    SORT gt_lifnr_det1 BY qunum qupos lifnr.

    LOOP AT gt_lifnr_det1 INTO DATA(lwa_lifnr_det1).

      IF lwa_lifnr_det1-qupos EQ '001'.
        gwa_final-supplier1    = lwa_lifnr_det1-lifnr.
        gwa_final-supplier_nm1 = lwa_lifnr_det1-name1.
        gwa_final-ex_sup_sob1 = lwa_lifnr_det1-quote.
      ENDIF.
      IF lwa_lifnr_det1-qupos EQ '002' .
        gwa_final-supplier2   = lwa_lifnr_det1-lifnr.
        gwa_final-supplier_nm2 = lwa_lifnr_det1-name1.
        gwa_final-ex_sip_sob2 = lwa_lifnr_det1-quote.
      ENDIF.
      gwa_final-qunum =  lwa_lifnr_det1-qunum.

      READ TABLE gt_equk INTO DATA(lwa_equk) WITH KEY qunum = lwa_lifnr_det1-qunum.
      IF sy-subrc EQ 0 .
        gwa_final-part_no      = lwa_equk-matnr.
        gwa_final-part_name    = lwa_equk-maktx.
        gwa_final-werks        = lwa_equk-werks.
      ENDIF.

      READ TABLE gt_unit_price_det INTO DATA(lwa_unit_price_det) WITH KEY matnr = gwa_final-part_no
                                                                          lifnr = gwa_final-supplier1
                                                                          werks = gwa_final-werks.
      IF sy-subrc EQ 0 .
        gwa_final-sup_ut_pr1 = lwa_unit_price_det-kbetr.
      ENDIF.

      READ TABLE gt_unit_price_det INTO DATA(lwa_unit_price_det1) WITH KEY matnr = gwa_final-part_no
                                                                          lifnr = gwa_final-supplier2
                                                                          werks = gwa_final-werks.
      IF sy-subrc EQ 0 .
        gwa_final-sup_ut_pr2 = lwa_unit_price_det1-kbetr.
      ENDIF.

      gwa_final-sub_at = sy-uzeit.
      gwa_final-sub_on = sy-datum.
      gwa_final-sub_by = sy-uname.
**      ENDIF.

      AT END OF qunum.
        IF gwa_final-supplier1 IS NOT INITIAL AND gwa_final-supplier2 IS NOT INITIAL.
          APPEND gwa_final TO gt_final.
        ENDIF.
        CLEAR :  gwa_final.
      ENDAT.

      CLEAR :
      lwa_equk, lwa_lifnr_det1, lwa_unit_price_det,
      lwa_unit_price_det1.
    ENDLOOP.
  ENDMETHOD.


  METHOD display.

    CALL SCREEN 100.

  ENDMETHOD.




  METHOD field_cat.

    it_fieldcat = VALUE #(
                    ( fieldname = 'PART_NO'       scrtext_l = TEXT-003    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'WERKS'         scrtext_l = TEXT-005    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'QUNUM'         scrtext_l = TEXT-026    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'PART_NAME'     scrtext_l = TEXT-004    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'SUPPLIER1'     scrtext_l = TEXT-006    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'SUPPLIER_NM1'  scrtext_l = TEXT-007    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'SUP_UT_PR1'    scrtext_l = TEXT-008    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'EX_SUP_SOB1'   scrtext_l = TEXT-009    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'RE_SUP_SOB1'   scrtext_l = TEXT-010    outputlen = 'X'     col_opt = 'X' edit = 'X')
                    ( fieldname = 'SUPPLIER2'     scrtext_l = TEXT-011    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'SUPPLIER_NM2'  scrtext_l = TEXT-012    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'SUP_UT_PR2'    scrtext_l = TEXT-013    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'EX_SIP_SOB2'   scrtext_l = TEXT-014    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'RE_SIP_SOB2'   scrtext_l = TEXT-015    outputlen = 'X'     col_opt = 'X' edit = 'X')
                    ( fieldname = 'VEHICLE_UT'    scrtext_l = TEXT-016    outputlen = 'X'     col_opt = 'X')
                    ( fieldname = 'AVG_MON_EST'   scrtext_l = TEXT-017    outputlen = 'X'     col_opt = 'X')
                    ).

  ENDMETHOD.
ENDCLASS.




