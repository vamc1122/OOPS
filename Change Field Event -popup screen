CLASS c1 IMPLEMENTATION.
  METHOD handle_data_change .

    TYPES:
      BEGIN OF t_tabix_rowid,
        tabix TYPE sy-tabix,
        rowid TYPE i,
      END OF t_tabix_rowid.
    DATA: ls_mod_cells   LIKE LINE OF er_data_changed->mt_mod_cells,
          ls_del_row     TYPE lvc_s_moce,
          lt_tabix_rowid TYPE SORTED TABLE OF t_tabix_rowid WITH UNIQUE KEY tabix,
          ls_tabix_rowid LIKE LINE OF lt_tabix_rowid.
    DATA : msg1 TYPE char70.
    DATA : msg2 TYPE char70.
    LOOP AT er_data_changed->mt_mod_cells INTO ls_mod_cells.
      READ TABLE lt_tabix_rowid TRANSPORTING NO FIELDS
        WITH TABLE KEY tabix = ls_mod_cells-tabix.

      IF sy-subrc <> 0.
        CLEAR ls_tabix_rowid.
        ls_tabix_rowid-tabix = ls_mod_cells-tabix.
        ls_tabix_rowid-rowid = ls_mod_cells-row_id.
        INSERT ls_tabix_rowid INTO TABLE lt_tabix_rowid.
      ENDIF.
    ENDLOOP.
    DATA : t1 TYPE TABLE OF ts_zmm_sob.
    FIELD-SYMBOLS : <fs_tab>  LIKE t1,
                    <fs_data> LIKE LINE OF <fs_tab>.

    ASSIGN er_data_changed->mp_mod_rows->* TO <fs_tab>.
*DATA lv_amt101 TYPE menge_d.
*  Validate entries
    LOOP AT <fs_tab> ASSIGNING <fs_data>.
      READ TABLE lt_tabix_rowid INTO ls_tabix_rowid INDEX sy-tabix.


      DATA(lv_amt101) = REDUCE #( INIT sum = CONV matdoc-menge( 0 )

                                        FOR gs_matdoc IN gt_matdoc WHERE ( matnr = <fs_data>-part_no AND
                                      ( lifnr = <fs_data>-supplier1 OR lifnr = <fs_data>-supplier2 ) AND
                                                                         werks = <fs_data>-werks     AND
                                                                          bwart = '101' )
                                        NEXT sum = sum + gs_matdoc-menge ).
      DATA(lv_amt102) = REDUCE #( INIT sum = CONV matdoc-menge( 0 )

                                        FOR gs_matdoc IN gt_matdoc WHERE ( matnr = <fs_data>-part_no AND
                                      ( lifnr = <fs_data>-supplier1 OR lifnr = <fs_data>-supplier2 ) AND
                                                                            werks = <fs_data>-werks  AND
                                                                          bwart = '102' )
                                        NEXT sum = sum + gs_matdoc-menge ).
      DATA(lv_amt) =  lv_amt101 - lv_amt102.

      IF <fs_data>-re_sup_sob1 IS NOT INITIAL AND <fs_data>-re_sip_sob2 IS NOT INITIAL.
        IF (  <fs_data>-re_sup_sob1  + <fs_data>-re_sip_sob2 ) NE 100 .
          msg1 = |Kindly give Revised Supplier 1&2 SOB% Equal to| ##NO_TEXT.
          msg2 = |100% For Quata No.{ <fs_data>-qunum ALPHA = OUT } | ##NO_TEXT.
          CALL METHOD er_data_changed->add_protocol_entry
            EXPORTING
              i_msgid     = '0K'
              i_msgno     = '000'
              i_msgty     = 'E'
              i_msgv1     = msg1
              i_msgv2     = msg2
              i_fieldname = 'RE_SUP_SOB1'
              i_row_id    = ls_tabix_rowid-rowid.
        ELSEIF ( <fs_data>-ex_sup_sob1 = <fs_data>-re_sup_sob1 ) OR ( <fs_data>-ex_sip_sob2 = <fs_data>-re_sip_sob2 ).
          msg1 = | Existing and Revised Supplier SOB% Cannot be| ##NO_TEXT.
          msg2 = |Equal For Quata No. { <fs_data>-qunum ALPHA = OUT } | ##NO_TEXT .
          CALL METHOD er_data_changed->add_protocol_entry
            EXPORTING
              i_msgid     = '0K'
              i_msgno     = '000'
              i_msgty     = 'E'
              i_msgv1     = msg1
              i_msgv2     = msg2
              i_fieldname = 'RE_SUP_SOB1'
              i_row_id    = ls_tabix_rowid-rowid.

        ELSEIF ( <fs_data>-ex_sup_sob1 > <fs_data>-re_sup_sob1 ) AND ( <fs_data>-ex_sip_sob2 < <fs_data>-re_sip_sob2 ).
          <fs_data>-vehicle_ut  =  <fs_data>-sup_ut_pr2 - <fs_data>-sup_ut_pr1 .
          <fs_data>-avg_mon_est = ( lv_amt / 3 ) * <fs_data>-vehicle_ut.
        ELSEIF ( <fs_data>-re_sup_sob1 > <fs_data>-ex_sup_sob1 ) AND ( <fs_data>-re_sip_sob2 < <fs_data>-ex_sip_sob2 ).
          <fs_data>-vehicle_ut  =  <fs_data>-sup_ut_pr1 - <fs_data>-sup_ut_pr2 .
          <fs_data>-avg_mon_est = ( lv_amt / 3 ) * <fs_data>-vehicle_ut.
        ELSE.
*          CLEAR <fs_data>-vehicle_ut.
        ENDIF.
*        sup_ut_pr1 - sup_ut_pr2
        CALL METHOD er_data_changed->modify_cell
          EXPORTING
            i_row_id    = ls_tabix_rowid-rowid
            i_fieldname = 'VEHICLE_UT'
            i_value     = <fs_data>-vehicle_ut.
        CALL METHOD er_data_changed->modify_cell
          EXPORTING
            i_row_id    = ls_tabix_rowid-rowid
            i_fieldname = 'AVG_MON_EST'
            i_value     = <fs_data>-avg_mon_est.
      ELSEIF  <fs_data>-re_sup_sob1 IS INITIAL.

        msg1 = |Please Enter Revised Supplier1 For Quata No.| ##NO_TEXT.
        msg2 = |{ <fs_data>-qunum ALPHA = OUT }|.
        CALL METHOD er_data_changed->add_protocol_entry
          EXPORTING
            i_msgid     = '0K'
            i_msgno     = '000'
            i_msgty     = 'E'
            i_msgv1     = msg1
            i_msgv2     = msg2
            i_fieldname = 'RE_SUP_SOB1'
            i_row_id    = ls_tabix_rowid-rowid.
      ELSEIF  <fs_data>-re_sip_sob2 IS INITIAL.
        msg1 = |Please Enter Revised Supplier2 For Quata No.{ <fs_data>-qunum ALPHA = OUT }| ##NO_TEXT .
        CALL METHOD er_data_changed->add_protocol_entry
          EXPORTING
            i_msgid     = '0K'
            i_msgno     = '000'
            i_msgty     = 'E'
            i_msgv1     = msg1
            i_fieldname = 'RE_SIP_SOB2'
            i_row_id    = ls_tabix_rowid-rowid.
      ENDIF.
      CLEAR: lv_amt101,lv_amt102,lv_amt.
    ENDLOOP.

  ENDMETHOD.
ENDCLASS.
