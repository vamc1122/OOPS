  DATA ls_fcat TYPE lvc_s_fcat.

  lcl_class=>field_cat( ).

  LOOP AT it_fieldcat INTO ls_fcat.

    IF   ls_fcat-fieldname = TEXT-028 "RE_SIP_SOB2'
