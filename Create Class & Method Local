REPORT ZSDR_CLASS.


CLASS LC_CLASS DEFINITION DEFERRED.

DATA: LO_CLASS TYPE REF TO LC_CLASS.
DATA WA_MARA TYPE MARA.
   DATA:   WA_MARC TYPE MARC.
   PARAMETERS P_MATNR TYPE MARA-MATNR.

   CLASS LC_CLASS DEFINITION.
  PUBLIC SECTION.

  METHODS: GET_MATERIALS_DETAILS
  IMPORTING IM_MATNR TYPE MARA-MATNR
  EXPORTING EX_MARA TYPE MARA.

  CLASS-METHODS:GET_MATERIALS_DESCRITIONS
  IMPORTING IM_MATNR TYPE marc-matnr
  EXPORTING ex_mARC TYPE marc.
  ENDCLASS.

CREATE OBJECT LO_CLASS.

CALL METHOD LO_CLASS->GET_MATERIALS_DETAILS
  EXPORTING
    IM_MATNR = P_MATNR
  IMPORTING
    EX_MARA  = WA_MARA.
CALL METHOD LC_CLASS=>GET_MATERIALS_DESCRITIONS
  EXPORTING
    IM_MATNR = P_MATNR
  IMPORTING
    EX_MARC  = WA_MARC.
WRITE:/ WA_MARA-MATNR,WA_MARA-MEINS.
WRITE :/ WA_MARC-MATNR.

*&---------------------------------------------------------------------*
*&       Class (Implementation)  LC_CLASS
*&---------------------------------------------------------------------*
*        Text
*----------------------------------------------------------------------*
CLASS LC_CLASS IMPLEMENTATION.

  METHOD GET_MATERIALS_DETAILS.
  SELECT SINGLE * FROM MARA INTO EX_MARA WHERE MATNR = IM_MATNR.
  ENDMETHOD.

  METHOD GET_MATERIALS_DESCRITIONS.
    SELECT SINGLE * FROM MARC INTO EX_MARC WHERE MATNR = IM_MATNR.
  ENDMETHOD.


ENDCLASS.
