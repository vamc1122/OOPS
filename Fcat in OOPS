  WA_FCATL-COL_POS = '1'.
  WA_FCATL-FIELDNAME = 'MATNR'.
  WA_FCATL-SCRTEXT_M = 'MATERIAL NUMBER'.
  WA_FCATL-TABNAME = 'MARA'.
  APPEND WA_FCATL TO IT_FCATL.
  CLEAR WA_FCATL.
  WA_FCATL-COL_POS = '2'.
  WA_FCATL-FIELDNAME = 'MTART'.
  WA_FCATL-SCRTEXT_M = 'MATERIAL TYPE'.
  WA_FCATL-TABNAME = 'MARA'.
  APPEND WA_FCATL TO IT_FCATL.
  CLEAR WA_FCATL.
  WA_FCATL-COL_POS = '3'.
  WA_FCATL-FIELDNAME = 'MBRSH'.
  WA_FCATL-SCRTEXT_M = 'INDUSTRY SECTOR'.
  WA_FCATL-TABNAME = 'MARA'.
