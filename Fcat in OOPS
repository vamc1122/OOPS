  WA_FCATL-TABNAME = 'MARA'.
  APPEND WA_FCATL TO IT_FCATL.
  CLEAR WA_FCATL.


  SELECT MATNR MTART MBRSH MATKL MEINS FROM MARA INTO TABLE IT_MARA WHERE MATNR IN S_MATNR.

 CALL METHOD LO_ALV->SET_TABLE_FOR_FIRST_DISPLAY
