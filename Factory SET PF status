REPORT ZOOABAP_FCAT_FACTORY.

 TYPES : BEGIN OF TY_MARA,
        MATNR TYPE MARA-MATNR,
        MTART TYPE MARA-MTART,
        MBRSH TYPE MARA-MBRSH,
        MATKL TYPE MARA-MATKL,
        MEINS TYPE MARA-MEINS,
      END OF TY_MARA.
DATA: IT_MARA TYPE STANDARD TABLE OF TY_MARA,
      WA_MARA TYPE TY_MARA.
DATA : LO_ALV TYPE REF TO CL_SALV_TABLE,
       LO_COLUMN TYPE REF TO CL_SALV_COLUMNS_TABLE,
       LO_COL TYPE REF TO CL_SALV_COLUMN_TABLE.
CLASS LCL_HANDLE_EVENTS DEFINITION DEFERRED.
START-OF-SELECTION.
SELECT MATNR MTART MBRSH MATKL MEINS FROM MARA INTO TABLE IT_MARA UP TO 50 ROWS.

*  TRY.
  CALL METHOD CL_SALV_TABLE=>FACTORY
    IMPORTING
      R_SALV_TABLE   = LO_ALV
    CHANGING
      T_TABLE        = IT_MARA
      .
CALL METHOD LO_ALV->GET_COLUMNS
  RECEIVING
    VALUE  = LO_COLUMN.

LO_COL ?= LO_COLUMN->GET_COLUMN( COLUMNNAME = 'MATNR' ).
*            CATCH CX_SALV_NOT_FOUND.  "

CALL METHOD LO_COL->SET_CELL_TYPE
  EXPORTING
    VALUE  = IF_SALV_C_CELL_TYPE=>HOTSPOT.

DATA: GR_EVENTS TYPE REF TO LCL_HANDLE_EVENTS.

CLASS LCL_HANDLE_EVENTS DEFINITION.

  PUBLIC SECTION.
  METHODS: ON_LINE_CLICK FOR EVENT LINK_CLICK OF CL_SALV_EVENTS_TABLE
     IMPORTING ROW COLUMN.
  ENDCLASS.

  DATA: LR_EVENTS TYPE REF TO CL_SALV_EVENTS_TABLE.
   LR_EVENTS = LO_ALV->GET_EVENT( ).

   CREATE OBJECT GR_EVENTS.
   SET HANDLER GR_EVENTS->ON_LINE_CLICK FOR LR_EVENTS.

LO_ALV->SET_SCREEN_STATUS(
  EXPORTING
    REPORT        =   'SALV_TEST_FUNCTIONS'  " ABAP PROGRAM: CURRENT MAIN PROGRAM
    PFSTATUS      =    'SALV_STANDARD' " SCREENS, CURRENT GUI STATUS
    SET_FUNCTIONS =    LO_ALV->C_FUNCTIONS_ALL ).

LO_ALV->DISPLAY( ).

*&---------------------------------------------------------------------*
*&       CLASS (IMPLEMENTATION)  LCL_HANDLE_EVENTS
*&---------------------------------------------------------------------*
*        TEXT
*----------------------------------------------------------------------*
CLASS LCL_HANDLE_EVENTS IMPLEMENTATION.
  METHOD ON_LINE_CLICK .
    READ TABLE IT_MARA INTO WA_MARA INDEX ROW.
    SET PARAMETER ID 'MAT' FIELD WA_MARA-MATNR.
    CALL TRANSACTION 'MM03' AND SKIP FIRST SCREEN.
    ENDMETHOD.
ENDCLASS.               "LCL_HANDLE_EVENTS
