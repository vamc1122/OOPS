CLASS lcl_class IMPLEMENTATION.
  METHOD fetch_logic.

    SELECT * FROM zmm_sob INTO TABLE @it_zmm_sob
       WHERE part_no   IN @s_partno
         AND werks     IN @s_werks
         AND ( supplier1 IN @s_lifnr OR supplier2 IN @s_lifnr )
         AND app_date IN @lv_date
         AND app_status = @p_status
         AND sob_status ne 'Updated'.
  ENDMETHOD.

  METHOD process_logic.
    fetch_logic( ).

    IF it_zmm_sob IS NOT INITIAL.
      LOOP AT it_zmm_sob INTO DATA(wa_zmm_sob).
        MOVE-CORRESPONDING wa_zmm_sob TO gs_final.
        IF gs_final-sob_status IS INITIAL.
          gs_final-sob_status = TEXT-035.
        ENDIF.
        IF gs_final-upd_sob IS INITIAL.
          gs_final-upd_sob = |{ c_sset }Create/Update | ."#notext.
        ENDIF.
        APPEND gs_final TO gt_final.
        CLEAR : gs_final.
      ENDLOOP.
    ELSE.
      MESSAGE TEXT-036 TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.
  ENDMETHOD.

