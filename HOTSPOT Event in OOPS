  METHOD create_update.
    DATA : ls_equku TYPE equku.
    DATA : ls_upd TYPE char1 .
    DATA : quota_no  TYPE qunum,
           it_equpu  TYPE TABLE OF  equpu,
           wa_equpu  TYPE equpu,
           et_return TYPE TABLE OF  bapiret2.

    CLEAR :ls_equku,ls_upd,quota_no.
    REFRESH : it_equpu,et_return.

    ls_equku-mandt = sy-mandt.
    ls_equku-matnr = gs_final-part_no.
    ls_equku-werks = gs_final-werks.
    ls_equku-bdatu = sy-datum.
    ls_equku-vdatu = sy-datum  - 30.
    IF gs_final-qunum IS NOT INITIAL.
      ls_equku-qunum = gs_final-qunum.
      ls_equku-kz = 'U'.
      ls_upd = 'X'.
    ELSE.
      ls_equku-qunum = gs_final-qunum.
      ls_equku-kz = 'I'.
    ENDIF.


    wa_equpu-mandt = sy-mandt.
    wa_equpu-qunum = gs_final-qunum.
    wa_equpu-qupos = '001'.
    wa_equpu-beskz = 'F'.
    wa_equpu-sobes = '0'.
    wa_equpu-lifnr = gs_final-supplier1.
    wa_equpu-quote = gs_final-re_sup_sob1.
    IF gs_final-qunum IS NOT INITIAL.
      wa_equpu-kz = 'U'.
    ELSE.
      wa_equpu-kz = 'I'.
    ENDIF.
    APPEND wa_equpu TO it_equpu.
    CLEAR : wa_equpu.

    wa_equpu-mandt = sy-mandt.
    wa_equpu-qunum = gs_final-qunum.
    wa_equpu-qupos = '002'.
    wa_equpu-beskz = 'F'.
    wa_equpu-sobes = '0'.
    wa_equpu-lifnr = gs_final-supplier2.
    wa_equpu-quote = gs_final-re_sip_sob2.
    IF gs_final-qunum IS NOT INITIAL.
      wa_equpu-kz = 'U'.
    ELSE.
      wa_equpu-kz = 'I'.
    ENDIF.
    APPEND wa_equpu TO it_equpu.
    CLEAR : wa_equpu.


    CALL FUNCTION 'CNV_PE_S4_QUOTA_ARRANGEMENT'
      EXPORTING
        is_equku       = ls_equku
        iv_update_flag = ls_upd
      IMPORTING
        ev_quota_num   = quota_no
      TABLES
        it_equpu       = it_equpu
        et_return      = et_return.

    IF quota_no IS INITIAL.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.
    ENDIF.

    CLEAR :titel,txt1,txt2,txt3.


    IF quota_no IS INITIAL.
      titel = TEXT-037.
      SORT et_return BY type id number.
      DELETE ADJACENT DUPLICATES FROM et_return COMPARING type id number.
      LOOP AT et_return INTO DATA(wa_return) WHERE type = 'E' OR type = 'A'.
        CLEAR : wa_return-message.
        CALL FUNCTION 'FORMAT_MESSAGE'
          EXPORTING
            id        = wa_return-id
            lang      = '-D'
            no        = wa_return-number
          IMPORTING
            msg       = wa_return-message
          EXCEPTIONS
            not_found = 1
            OTHERS    = 2.
        IF sy-subrc <> 0.
* Implement suitable error handling here
        ENDIF.

        IF sy-tabix = 1.
          txt1 = wa_return-message.
        ELSEIF sy-tabix = 2.
          txt2 = wa_return-message.
        ELSEIF sy-tabix = 3.
          txt3 = wa_return-message.
          EXIT.
        ENDIF.
        CLEAR : wa_return.
      ENDLOOP.
*      IF txt1 IS INITIAL.
*        txt1 = 'Error In BAPI'. ##NO_TEXT
*      ENDIF.
      if gs_final-remarks is INITIAL AND gs_final-sob_status is INITIAL.
      gs_final-remarks = wa_return-message.
      gs_final-sob_status = TEXT-037.
      endif.
*    ELSEIF wa_return-type = 'S' OR quota_no IS NOT INITIAL.
    ELSE.
      titel = TEXT-038.
      txt1 = TEXT-040.
      gs_final-qunum = quota_no.
      gs_final-sob_status = TEXT-039.
    ENDIF.


  ENDMETHOD.

  METHOD display.

    CALL SCREEN 100.
  ENDMETHOD.

ENDCLASS.


