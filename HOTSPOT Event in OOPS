*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  DATA l_valid TYPE char1.
  CALL METHOD obj1->g_grid->check_changed_data
    IMPORTING
      e_valid = l_valid.
  IF sy-ucomm = 'BACK' .
    READ TABLE gt_final INTO gs_final WITH KEY sob_status = TEXT-039.
    IF sy-subrc NE 0.
      lv_save = 'X'.
    ENDIF.
    IF flag  = 'X' AND lv_save NE 'X'.
      MESSAGE TEXT-041 TYPE 'I'.
    ELSE.
      SET SCREEN 0.
      LEAVE SCREEN.
    ENDIF.
  ELSEIF sy-ucomm = 'EXIT'.
    READ TABLE gt_final INTO gs_final WITH KEY sob_status = TEXT-039.
    IF sy-subrc NE 0.
      lv_save = 'X'.
    ENDIF.
    IF flag  = 'X' AND lv_save NE 'X'.
      MESSAGE TEXT-041 TYPE 'I'.
    ELSE.
      SET SCREEN 0.
      LEAVE SCREEN.
    ENDIF.
  ELSEIF sy-ucomm = 'CANCEL'.
    READ TABLE gt_final INTO gs_final WITH KEY sob_status = TEXT-039.
    IF sy-subrc NE 0.
      lv_save = 'X'.
    ENDIF.
    IF flag  = 'X' AND lv_save NE 'X'.
      MESSAGE TEXT-041 TYPE 'I'.
    ELSE.
      SET SCREEN 0.
      LEAVE SCREEN.
    ENDIF.
  ELSEIF sy-ucomm = 'SAVE'.

    REFRESH  gt_zmm_sob.
    READ TABLE gt_final INTO gs_final WITH KEY sob_status = TEXT-039 chk = abap_true.
    IF sy-subrc = 0.
      lv_save = 'X'.
      LOOP AT gt_final INTO gs_final WHERE sob_status = TEXT-039 AND chk = abap_true.

        MOVE-CORRESPONDING gs_final TO gs_zmm_sob.
        APPEND gs_zmm_sob TO gt_zmm_sob.
        MODIFY gt_final FROM gs_final
         TRANSPORTING sob_status.
        MODIFY zmm_sob FROM gs_zmm_sob.
        IF sy-subrc = 0.
          COMMIT WORK AND WAIT.
          MESSAGE TEXT-025 TYPE 'S' DISPLAY LIKE 'S'.
        ENDIF.
        CLEAR : gt_zmm_sob,gs_final,gs_zmm_sob.
      ENDLOOP.
    ELSE.
      MESSAGE TEXT-043 TYPE 'I'.
      CLEAR : gs_final.
    ENDIF.

  ELSEIF sy-ucomm = 'DESELECT'.

    LOOP AT gt_final INTO gs_final WHERE chk = 'X'.

      CLEAR gs_final-chk.
      MODIFY gt_final FROM gs_final TRANSPORTING chk.
      CLEAR: gs_final.
    ENDLOOP.
  ELSEIF sy-ucomm = 'SELECT'.
    LOOP AT gt_final INTO gs_final WHERE chk NE 'X'.

      gs_final-chk = 'X'.
      MODIFY gt_final FROM gs_final TRANSPORTING chk.
      CLEAR: gs_final.
    ENDLOOP.
  ELSEIF sy-ucomm = 'UPDATEALL'.

    REFRESH : gt_out.
    READ TABLE gt_final INTO gs_final WITH KEY chk = abap_true.
    IF sy-subrc = 0.
      SELECT * FROM zmm_sob INTO TABLE @DATA(lt_ymm_sob)
           WHERE part_no = @gs_final-part_no
        AND werks = @gs_final-werks .
      LOOP AT gt_final INTO gs_final WHERE chk EQ abap_true.
        gs_out-srno = gs_out-srno + 1.
        IF gs_final-sob_status NE TEXT-039 .
          READ TABLE lt_ymm_sob INTO DATA(wa_ymm_sob) WITH KEY part_no = gs_final-part_no
            werks = gs_final-werks qunum = gs_final-qunum.
          IF wa_ymm_sob IS NOT INITIAL AND wa_ymm_sob-sob_status NE TEXT-039.
            IF gs_final-qunum IS NOT INITIAL.
              lcl_class=>create_update( ).
            ELSE.
              lcl_class=>create_update( ).
            ENDIF.
            IF gs_final-sob_status = TEXT-039.
              flag = 'X'.
            ENDIF.
            MODIFY gt_final FROM gs_final
             TRANSPORTING sob_status remarks qunum .

            MOVE-CORRESPONDING gs_final TO gs_out.
            gs_out-remarks = TEXT-045.
            gs_out-status = gs_final-sob_status.
            APPEND gs_out TO gt_out.
          ELSE.
            MOVE-CORRESPONDING gs_final TO gs_out.
            gs_out-remarks = TEXT-044.
            APPEND gs_out TO gt_out.
          ENDIF.
        ELSE.
          MOVE-CORRESPONDING gs_final TO gs_out.
          gs_out-remarks = TEXT-045.
          APPEND gs_out TO gt_out.
        ENDIF.
        CLEAR: gs_out-remarks,gs_out-part_no,gs_out-qunum,gs_out-supplier1, gs_final.
      ENDLOOP.
      CLEAR : gs_out.
      IF gt_out IS NOT INITIAL.
        CALL SCREEN 2000.
      ENDIF.
      REFRESH : lt_ymm_sob.
    ELSE.
      MESSAGE TEXT-047 TYPE 'I' .
    ENDIF.
  ENDIF.

ENDMODULE.



CLASS c1 IMPLEMENTATION.
  METHOD handle_button_click.

    READ TABLE gt_final INTO gs_final INDEX e_row_id-index.
    IF sy-subrc = 0 AND gs_final-chk = abap_true.
      IF gs_final-sob_status NE TEXT-039 .
        SELECT SINGLE * FROM zmm_sob INTO @DATA(w_ymm_sob)
             WHERE part_no = @gs_final-part_no
          AND werks = @gs_final-werks AND qunum = @gs_final-qunum.
        IF w_ymm_sob IS NOT INITIAL AND w_ymm_sob-sob_status NE TEXT-039.
          IF gs_final-qunum IS NOT INITIAL.
            lcl_class=>create_update( ).
          ELSE.
            lcl_class=>create_update( ).
          ENDIF.
          IF sy-ucomm NE 'UPDATEALL'.
            CALL FUNCTION 'POPUP_TO_INFORM'
              EXPORTING
                titel = titel
                txt1  = txt1
                txt2  = txt2
                txt3  = txt3.
          ENDIF.
          IF gs_final-sob_status = TEXT-039.
            flag = 'X'.
          ENDIF.
          MODIFY gt_final FROM gs_final INDEX e_row_id-index
           TRANSPORTING sob_status remarks qunum.
        ELSE.
          MESSAGE TEXT-044 TYPE 'I' .
        ENDIF.

        CALL METHOD g_grid->refresh_table_display
          EXCEPTIONS
            finished = 1
            OTHERS   = 2.
        IF sy-subrc <> 0.
*      * Handle error
        ENDIF.
      ELSE.
        MESSAGE TEXT-045 TYPE 'I' .
      ENDIF.
    ELSE.
      MESSAGE TEXT-047 TYPE 'I' .
    ENDIF.

    CLEAR: w_ymm_sob,gs_final.
  ENDMETHOD.

ENDCLASS.
