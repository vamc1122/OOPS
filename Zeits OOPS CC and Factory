
CLASS CL_METHOD_EVENT DEFINITION DEFERRED.

TABLES: VBAK,VBAP,KNA1,TVAKT,T001W,MAKT.
TYPE-POOLS : SLIS.

 SELECTION-SCREEN BEGIN OF BLOCK A1 WITH FRAME TITLE TEXT-001.
   SELECT-OPTIONS :S_VBELN FOR VBAK-VBELN,
                   S_AUDAT FOR VBAK-AUDAT,
                   S_MATNR FOR VBAP-MATNR,
                   S_KUNNR FOR VBAK-KUNNR,
                   S_AUART FOR VBAK-AUART NO INTERVALS.
  PARAMETERS : P_VKORG TYPE VBAK-VKORG .
 SELECTION-SCREEN END OF BLOCK A1.
  "----------------------------------------------------------

INITIALIZATION.
  SELECT DISTINCT VBAK~VKORG
    FROM VBAK INNER JOIN VBAP ON VBAK~VBELN = VBAP~VBELN
    WHERE VBAK~VBELN IN  @S_VBELN
  AND VBAP~MATNR IN @S_MATNR
  INTO TABLE @DATA(LT_VKORG).

  IF LT_VKORG IS NOT INITIAL.

    READ TABLE LT_VKORG INTO DATA(LV_VKORG) INDEX 1.

  ELSE.
    LV_VKORG = ' '.
  ENDIF.

  S_AUDAT-LOW = SY-DATUM - 10.
  S_AUDAT-HIGH = SY-DATUM.
  p_vkorg = lv_vkorg-vkorg.
  APPEND S_AUDAT.
"-------------------------------------------------------------

AT SELECTION-SCREEN ON S_AUART.


  SELECT AUART FROM TVAKT INTO TABLE @DATA(IT_AUART) WHERE AUART IN @S_AUART.

  IF SY-SUBRC <> 0.
    MESSAGE E000(ZMSG) WITH S_AUART-LOW DISPLAY LIKE 'E'.
  ENDIF.
"-------------------------------------------------------------------------------------


START-OF-SELECTION.


    TYPES : BEGIN OF TY_FINAL,
            VBELN  TYPE VBAK-VBELN,
            AUDAT  TYPE VBAK-AUDAT,
            AUART  TYPE VBAK-AUART,
            VKORG  TYPE VBAK-VKORG,
            SPART  TYPE VBAK-SPART,
            KUNNR  TYPE VBAK-KUNNR,
            NAME1  TYPE KNA1-NAME1,
            POSNR  TYPE VBAP-POSNR,
            MATNR  TYPE VBAP-MATNR,
            WERKS  TYPE VBAP-WERKS,
            SPRAS  TYPE TVAKT-SPRAS,
            BEZEI  TYPE TVAKT-BEZEI,
            NAME11 TYPE T001W-NAME1,
            MAKTX  TYPE MAKT-MAKTX,
          END OF TY_FINAL.

  DATA: IT_FINAL TYPE STANDARD TABLE OF TY_FINAL,
        WA_FINAL TYPE TY_FINAL.
  DATA: IT_FCAT TYPE LVC_T_FCAT.
  DATA: WA_FCAT TYPE LVC_S_FCAT.



  " SELECT STATEMENT-----------------------------------------------
   SELECT VBELN,
       AUDAT,
       AUART,
       VKORG,
       SPART,
       KUNNR
  FROM VBAK INTO TABLE @DATA(IT_VBAK) WHERE  VBELN IN @S_VBELN AND
  AUDAT IN @S_AUDAT AND
  KUNNR IN @S_KUNNR AND
  AUART IN @S_AUART.
  IF SY-SUBRC = 0.
    SELECT VBELN,
           POSNR,
           MATNR,
           WERKS
    FROM VBAP INTO TABLE @DATA(IT_VBAP)
    FOR ALL ENTRIES IN @IT_VBAK
    WHERE VBELN = @IT_VBAK-VBELN AND MATNR IN @S_MATNR.
    IF SY-SUBRC = 0.
      SELECT WERKS,
             NAME1
      FROM T001W INTO TABLE @DATA(IT_T001W)
      FOR ALL ENTRIES IN @IT_VBAP
      WHERE WERKS = @IT_VBAP-WERKS.

      SELECT MATNR,
             SPRAS,
             MAKTX
      FROM MAKT INTO TABLE @DATA(IT_MAKT)
      FOR ALL ENTRIES IN @IT_VBAP
      WHERE MATNR = @IT_VBAP-MATNR AND SPRAS = @SY-LANGU.
    ENDIF.

    SELECT KUNNR,
           NAME1
    FROM KNA1 INTO TABLE @DATA(IT_KNA1)
    FOR ALL ENTRIES IN @IT_VBAK
    WHERE KUNNR = @IT_VBAK-KUNNR.

    SELECT SPRAS,
           AUART,
           BEZEI
    FROM TVAKT INTO TABLE @DATA(IT_TVAKT)
    FOR ALL ENTRIES IN @IT_VBAK
    WHERE AUART = @IT_VBAK-AUART AND SPRAS = @SY-LANGU.

  ENDIF.


  " LOOP STATEMENT--------------------------------------------------------------

  LOOP AT IT_VBAK INTO DATA(WA_VBAK).
    MOVE-CORRESPONDING WA_VBAK TO WA_FINAL.

    READ TABLE IT_VBAP INTO DATA(WA_VBAP) WITH KEY VBELN = WA_VBAK-VBELN.
    IF SY-SUBRC = 0.
      MOVE-CORRESPONDING WA_VBAP TO WA_FINAL.

      READ TABLE IT_T001W INTO DATA(WA_T001W) WITH KEY WERKS = WA_VBAP-WERKS.
      IF SY-SUBRC = 0.
        WA_FINAL-NAME11 = WA_T001W-NAME1.
      ENDIF.
      READ TABLE IT_MAKT INTO DATA(WA_MAKT) WITH KEY MATNR = WA_VBAP-MATNR.
      IF SY-SUBRC = 0.
        MOVE-CORRESPONDING WA_MAKT TO WA_FINAL.
      ENDIF.
    ENDIF.

    READ TABLE IT_KNA1 INTO DATA(WA_KNA1) WITH  KEY KUNNR = WA_VBAK-KUNNR .
    IF SY-SUBRC = 0.
      MOVE-CORRESPONDING WA_KNA1 TO WA_FINAL.
    ENDIF.
    READ TABLE IT_TVAKT INTO DATA(WA_TVAKT) WITH KEY AUART = WA_VBAK-AUART.
    IF SY-SUBRC = 0.
      MOVE-CORRESPONDING WA_TVAKT TO WA_FINAL.
    ENDIF.

    APPEND WA_FINAL TO IT_FINAL.
    CLEAR : WA_VBAK,WA_VBAP,WA_KNA1,WA_T001W,WA_MAKT,WA_TVAKT, WA_FINAL.
  ENDLOOP.


  " FIELD CATALOG----------------------------------------
  WA_FCAT-COL_POS = '1'.
  WA_FCAT-FIELDNAME = 'VBELN'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-HOTSPOT = 'X'.
  WA_FCAT-REPTEXT = 'SALES ORDER NUMBER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = '2'.
  WA_FCAT-FIELDNAME = 'AUART'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'ORDER TYPE'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '3'.
  WA_FCAT-FIELDNAME = 'BEZEI'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'ORDER DESCRIPTION'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '4'.
  WA_FCAT-FIELDNAME = 'KUNNR'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'CUSTOMER NUMBER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '5'.
  WA_FCAT-FIELDNAME = 'NAME1'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'CUSTOMER NAME'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '6'.
  WA_FCAT-FIELDNAME = 'VKORG'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'SALES ORGANISATION'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '7'.
  WA_FCAT-FIELDNAME = 'SPART'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'DIVISION'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '8'.
  WA_FCAT-FIELDNAME = 'POSNR'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'ITEM NUMBER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '9'.
  WA_FCAT-FIELDNAME = 'MATNR'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'MATERIAL NUMBER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '10'.
  WA_FCAT-FIELDNAME = 'MAKTX'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'MATERIAL DESCRIPTION'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '11'.
  WA_FCAT-FIELDNAME = 'WERKS'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'PLANT CODE'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.
  WA_FCAT-COL_POS = '12'.
  WA_FCAT-FIELDNAME = 'NAME11'.
  WA_FCAT-TABNAME = 'IT_FINAL'.
  WA_FCAT-REPTEXT = 'PLANT NAME'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.



" display in OOALV WITH CUSTOM CONTAINER-------------------------------------------
  DATA: lv_GRID TYPE REF TO CL_GUI_ALV_GRID.
  DATA: lr_events TYPE REF TO CL_METHOD_EVENT.
  DATA: CC_COUNT TYPE REF TO CL_GUI_CUSTOM_CONTAINER.


CREATE OBJECT CC_COUNT
  EXPORTING
    CONTAINER_NAME              =  'CUS_CONTAINER' .

CREATE OBJECT lv_grid
  EXPORTING
    I_PARENT                = CC_COUNT.


CALL METHOD lv_GRID->SET_TABLE_FOR_FIRST_DISPLAY
EXPORTING
 IS_LAYOUT = VALUE LVC_S_LAYO( CWIDTH_OPT   = 'X' )
    CHANGING
      IT_OUTTAB       = IT_FINAL[]               " OUTPUT TABLE
      IT_FIELDCATALOG = IT_FCAT[]  .



" EVENT HANDLER------------------------------------------------------------
 CLASS CL_METHOD_EVENT DEFINITION.
      PUBLIC SECTION.
        METHODS : SINGLE_CLICK FOR EVENT HOTSPOT_CLICK OF CL_GUI_ALV_GRID
          IMPORTING e_row_ID .
          ENDCLASS.

CREATE OBJECT LR_EVENTS.
SET HANDLER LR_EVENTS->SINGLE_CLICK FOR lv_GRID.

 CALL SCREEN 101.


 CLASS CL_METHOD_EVENT IMPLEMENTATION.
     METHOD SINGLE_CLICK .
    READ TABLE  IT_FINAL INTO WA_FINAL INDEX e_row_ID.
    IF SY-SUBRC = 0.
    SET PARAMETER ID 'AUN' FIELD WA_FINAL-VBELN.
    CALL TRANSACTION  'VA03' AND SKIP FIRST SCREEN.
    ENDIF.
    ENDMETHOD.

    ENDCLASS.


